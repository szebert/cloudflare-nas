{
  "name": "cloudflare-nas-monorepo",
  "description": "Cloudflare NAS - Personal cloud storage on Cloudflare",
  "scripts": {
    "dev": "pnpm --filter @cloudflare-nas/worker dev",
    "deploy": "pnpm --filter @cloudflare-nas/worker deploy",
    "build:cli": "pnpm --filter cloudflare-nas build",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2"
}
