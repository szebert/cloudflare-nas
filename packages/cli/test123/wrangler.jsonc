// Wrangler configuration for test123
// Documentation: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test123",
  "account_id": "ce7325971af06075ca53528eff0e5967",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-05",
  "r2_buckets": [
    {
      "binding": "nas-storage",
      "bucket_name": "r2-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test123-db-k8l96n",
      "database_id": "b8484eb2-3f93-4eb6-8e8f-a6e6edd0f2cc"
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.css"
      ],
      "fallthrough": true
    }
  ]
}
